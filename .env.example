# Required. The Anthropic SDK reads this directly.
ANTHROPIC_API_KEY=

# Optional. Must support adaptive thinking and the effort setting
# (claude-opus-5, claude-sonnet-5, claude-opus-4-8, claude-opus-4-7,
# claude-opus-4-6, claude-sonnet-4-6). Default: claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# Optional. If set, students must enter this code in the Context Generation
# tab before the server will call the model. Leave empty to disable.
ACCESS_CODE=

# Optional
GOOGLE_SITE_VERIFICATION_ID=
